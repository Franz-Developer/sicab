# C:\sicab\sicab-backend\src\modules\trabajadores-cargos\trabajadores-cargos.http
# ----------------------------------------------------------------------
# DEFINICIÓN DE VARIABLES
# ----------------------------------------------------------------------
@baseUrl = http://localhost:3010/api
@baseUrl_trabajadores_cargos = {{baseUrl}}/trabajadores-cargos
@baseUrl_trabajadores = {{baseUrl}}/trabajadores
@baseUrl_cargos = {{baseUrl}}/cargos
@baseUrl_constantes = {{baseUrl}}/constantes
@rest-client.previewOption = body

### 1. OBTENER TOKEN DE AUTENTICACIÓN (ADMIN).
# Se debe presionar primero.
# @name login
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "ADMIN",
    "password": "12345678"
}

### 2. GUARDAR TOKEN EN VARIABLE.
# No se debe presionar, es automático.
@authToken = {{login.response.body.token}}

# ==============================================================================
# AUTENTICACIÓN - USUARIO 3 (PRUEBA)
# ==============================================================================

### 1.b OBTENER TOKEN USUARIO 3
# @name loginUser3
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "PRUEBA",
    "password": "12345678"
}

### 2.b GUARDAR TOKEN USUARIO 3
# @authToken = {{loginUser3.response.body.token}}

# ==============================================================================
# ENDPOINTS DE APOYO
# ==============================================================================

### LISTAR TRABAJADORES ACTIVOS
GET {{baseUrl_trabajadores}}?estado_id=1000
Authorization: Bearer {{authToken}}

### LISTAR CARGOS ACTIVOS
GET {{baseUrl_cargos}}?estado_id=1000
Authorization: Bearer {{authToken}}

### LISTAR TIPOS DE MONEDA
GET {{baseUrl_constantes}}?tipo=tipo_moneda_id
Authorization: Bearer {{authToken}}

# ==============================================================================
# LISTAR TRABAJADORES CARGOS (GET)
# ==============================================================================

### LISTAR TODOS
GET {{baseUrl_trabajadores_cargos}}
Authorization: Bearer {{authToken}}

### LISTAR POR ESTADO ACTIVOS (1000)
GET {{baseUrl_trabajadores_cargos}}?estado_id=1000
Authorization: Bearer {{authToken}}

### LISTAR HISTÓRICOS (1002)
GET {{baseUrl_trabajadores_cargos}}?estado_id=1002
Authorization: Bearer {{authToken}}

### LISTAR BORRADOS (1001)
GET {{baseUrl_trabajadores_cargos}}?estado_id=1001
Authorization: Bearer {{authToken}}

# ==============================================================================
# FILTROS POR TRABAJADOR, CARGO Y MONEDA
# ==============================================================================

### FILTRAR POR TRABAJADOR_ID
GET {{baseUrl_trabajadores_cargos}}?trabajador_id=3
Authorization: Bearer {{authToken}}

### FILTRAR POR CARGO_ID
GET {{baseUrl_trabajadores_cargos}}?cargo_id=4
Authorization: Bearer {{authToken}}

### FILTRAR POR TIPO_MONEDA_ID
GET {{baseUrl_trabajadores_cargos}}?tipo_moneda_id=2300
Authorization: Bearer {{authToken}}

### FILTRAR POR ESTADO Y TRABAJADOR (combinado)
GET {{baseUrl_trabajadores_cargos}}?estado_id=1000&trabajador_id=3
Authorization: Bearer {{authToken}}

# ==============================================================================
# BÚSQUEDA POR TEXTO (q)
# ==============================================================================

### BÚSQUEDA FLEXIBLE (por nombre, apellido, DNI, apodo, cargo o código)
GET {{baseUrl_trabajadores_cargos}}?q=Juan
Authorization: Bearer {{authToken}}

### BÚSQUEDA EXACTA (coincidencia por palabra completa)
GET {{baseUrl_trabajadores_cargos}}?q=Juan&exactMatch=1
Authorization: Bearer {{authToken}}

# ==============================================================================
# PAGINACIÓN
# ==============================================================================

### PÁGINA 1: Registros 0 al 9
GET {{baseUrl_trabajadores_cargos}}?offset=0&limit=10
Authorization: Bearer {{authToken}}

### PÁGINA 2: Registros 10 al 19
GET {{baseUrl_trabajadores_cargos}}?offset=10&limit=10
Authorization: Bearer {{authToken}}

### Paginación con filtro de estado
GET {{baseUrl_trabajadores_cargos}}?estado_id=1000&offset=0&limit=10
Authorization: Bearer {{authToken}}

# ==============================================================================
# ORDENAMIENTO
# ==============================================================================

### ORDENAR POR ID (Ascendente)
GET {{baseUrl_trabajadores_cargos}}?sortField=trabajador_cargo_id&sortOrder=1
Authorization: Bearer {{authToken}}

### ORDENAR POR ID (Descendente)
GET {{baseUrl_trabajadores_cargos}}?sortField=trabajador_cargo_id&sortOrder=-1
Authorization: Bearer {{authToken}}

### ORDENAR POR FECHA DE REGISTRO (Más recientes primero)
GET {{baseUrl_trabajadores_cargos}}?sortField=fecha_registro&sortOrder=-1
Authorization: Bearer {{authToken}}

### ORDENAR POR SUELDO BASE (Mayor a menor)
GET {{baseUrl_trabajadores_cargos}}?sortField=sueldo_base&sortOrder=-1
Authorization: Bearer {{authToken}}

### ORDENAR POR FECHA_DESDE (Más antiguos primero)
GET {{baseUrl_trabajadores_cargos}}?sortField=fecha_desde&sortOrder=1
Authorization: Bearer {{authToken}}

# ==============================================================================
# COMBINACIÓN DE FILTROS + ORDENAMIENTO + PAGINACIÓN
# ==============================================================================

### ASIGNACIONES ACTIVAS, ordenadas por ID
GET {{baseUrl_trabajadores_cargos}}?estado_id=1000&sortField=trabajador_cargo_id&sortOrder=1&offset=0&limit=100
Authorization: Bearer {{authToken}}

### HISTÓRICOS DE UN TRABAJADOR, ordenados por fecha_desde DESC
GET {{baseUrl_trabajadores_cargos}}?estado_id=1002&trabajador_id=4&sortField=fecha_desde&sortOrder=-1
Authorization: Bearer {{authToken}}

# ==============================================================================
# OBTENER POR ID
# ==============================================================================

### OBTENER ASIGNACIÓN POR ID
GET {{baseUrl_trabajadores_cargos}}/17
Authorization: Bearer {{authToken}}

# ==============================================================================
# CREAR NUEVA ASIGNACIÓN
# ==============================================================================

### CREAR NUEVA ASIGNACIÓN (trabajador sin cargo vigente)
POST {{baseUrl_trabajadores_cargos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "trabajador_id": 18,
    "cargo_id": 9,
    "sueldo_base": 3500.00,
    "tipo_moneda_id": 2300,
    "fecha_desde": "2026-01-01",
    "observaciones": "Asignación inicial de cargo"
}

### CREAR SIN SUELDO_BASE (hereda del cargo)
POST {{baseUrl_trabajadores_cargos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "trabajador_id": 19,
    "cargo_id": 5,
    "tipo_moneda_id": 2300,
    "observaciones": "Sueldo heredado del cargo (CONDUCTOR)"
}

# ==============================================================================
# CAMBIAR CARGO (cierra el actual y crea uno nuevo)
# ==============================================================================

### CAMBIO DE CARGO: ascenso o cambio de puesto
POST {{baseUrl_trabajadores_cargos}}/cambiar-cargo
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "trabajador_id": 4,
    "cargo_id": 6,
    "sueldo_base": 3000.00,
    "tipo_moneda_id": 2300,
    "fecha_desde": "2026-10-07",
    "observaciones": "Ascenso a Operador de Radio II por desempeño destacado"
}

# ==============================================================================
# ACTUALIZAR TRABAJADOR CARGO (solo campos secundarios)
# ==============================================================================

### ACTUALIZAR SUELDO Y OBSERVACIONES (PATCH)
PATCH {{baseUrl_trabajadores_cargos}}/5
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "sueldo_base": 2900.00,
    "observaciones": "Ajuste salarial por evaluación semestral"
}

### ACTUALIZAR SOLO OBSERVACIONES
PATCH {{baseUrl_trabajadores_cargos}}/5
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "observaciones": "Se confirma turno mañana (06:00-14:00)"
}

### ACTUALIZAR FECHA_DESDE
PATCH {{baseUrl_trabajadores_cargos}}/5
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "fecha_desde": "2025-07-15"
}

# ==============================================================================
# ELIMINAR (Borrado lógico: ACTIVO → BORRADO)
# ==============================================================================

### ELIMINAR ASIGNACIÓN
DELETE {{baseUrl_trabajadores_cargos}}/17
Authorization: Bearer {{authToken}}

# ==============================================================================
# ARCHIVAR / DESARCHIVAR
# ==============================================================================

### ARCHIVAR (ACTIVO → HISTÓRICO 1002)
# Usar con cuidado: el flujo normal de cambio de cargo ya archiva el anterior.
PATCH {{baseUrl_trabajadores_cargos}}/18/archivar
Authorization: Bearer {{authToken}}

### DESARCHIVAR (HISTÓRICO 1002 → ACTIVO 1000)
# ❌ PROHIBIDO: debe devolver 403 Forbidden.
# Un cargo histórico no puede reactivarse porque generaría conflicto
# con el cargo ACTIVO vigente del trabajador (regla R.3 + índice único).
PATCH {{baseUrl_trabajadores_cargos}}/18/desarchivar
Authorization: Bearer {{authToken}}
