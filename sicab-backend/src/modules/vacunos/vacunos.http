### ACTUALIZAR VACUNO — Datos generales
PATCH {{baseUrl_vacunos}}/2
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "nombre": "LECHERA 001 ACTUALIZADA",
    "color": "BLANCO Y NEGRO",
    "peso_actual": 585.00,
    "observaciones": "PESAJE CORREGIDO POR ERROR DE TIPEO"
}

### ACTUALIZAR VACUNO — Fotografía
PATCH {{baseUrl_vacunos}}/2
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="foto"; filename="vaca-001.png"
Content-Type: image/png

< ./fotos/vaca-001.png
--boundary--

### ACTUALIZAR VACUNO — Cambiar a EN_TRATAMIENTO
PATCH {{baseUrl_vacunos}}/2
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6401
}

### CAMBIAR ESTADO — VENDIDO
PATCH {{baseUrl_vacunos}}/2/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6404,
    "fecha_salida": "2026-10-16",
    "motivo_salida": "VENTA",
    "peso_salida": 580.00,
    "precio_venta": 7500.00
}

### CAMBIAR ESTADO — MUERTO
PATCH {{baseUrl_vacunos}}/3/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6405,
    "fecha_salida": "2026-10-16",
    "motivo_salida": "MUERTE",
    "peso_salida": 560.00,
    "causa_muerte": "ENFERMEDAD RESPIRATORIA"
}

### CAMBIAR ESTADO — SECA (período seco)
PATCH {{baseUrl_vacunos}}/4/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6402
}

### ELIMINAR VACUNO (Borrado lógico por error de carga)
DELETE {{baseUrl_vacunos}}/2
Authorization: Bearer {{authToken}}

# ==============================================================================
# LISTAR VACAS VÁLIDAS PARA PRODUCCIÓN (Hembras, Productoras, Categoría VACA_LECHERA)
# ==============================================================================

### VACAS LECHERAS ACTIVAS
GET {{baseUrl_vacunos}}?estado_id=1000&sexo_biologico_id=6301&es_productor_leche=6351&categoria_vacuno_id=9&estado_vacuno_id=6400
Authorization: Bearer {{authToken}}

### VACAS LECHERAS DE VIACHA (sucursal_id=2)
GET {{baseUrl_vacunos}}?estado_id=1000&sucursal_id=2&sexo_biologico_id=6301&es_productor_leche=6351&categoria_vacuno_id=9&estado_vacuno_id=6400
Authorization: Bearer {{authToken}}

### BUSCAR VACA POR ARETE
GET {{baseUrl_vacunos}}?estado_id=1000&q=V-001&exactMatch=1
Authorization: Bearer {{authToken}}

### BUSCAR VACAS CON FILTRO DE TEXTO
GET {{baseUrl_vacunos}}?estado_id=1000&q=LECHERA&exactMatch=0
Authorization: Bearer {{authToken}}

### VACUNOS POR RANGO DE FECHA DE INGRESO
GET {{baseUrl_vacunos}}?estado_id=1000&fecha_ingreso_desde=2024-01-01&fecha_ingreso_hasta=2024-12-31
Authorization: Bearer {{authToken}}

### VACUNOS POR RANGO DE PESO (usando sortField para ordenar)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6400&sortField=peso_actual&sortOrder=-1&limit=10
Authorization: Bearer {{authToken}}

### VACUNOS POR EMPRESA
GET {{baseUrl_vacunos}}?estado_id=1000&empresa_id=2
Authorization: Bearer {{authToken}}

### VACUNOS HISTÓRICOS (para auditoría)
GET {{baseUrl_vacunos}}?estado_id=1002
Authorization: Bearer {{authToken}}

### VACUNOS VENDIDOS (finales)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6404
Authorization: Bearer {{authToken}}

### VACUNOS MUERTOS (finales)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6405
Authorization: Bearer {{authToken}}

### VACUNOS EN TRATAMIENTO
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6401
Authorization: Bearer {{authToken}}

### VACUNOS SECOS (no producen leche temporalmente)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6402
Authorization: Bearer {{authToken}}

### VACUNOS DE DESCARTE
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6403
Authorization: Bearer {{authToken}}

### PAGINACIÓN Y ORDENAMIENTO
GET {{baseUrl_vacunos}}?estado_id=1000&sortField=arete&sortOrder=1&offset=0&limit=10
Authorization: Bearer {{authToken}}
