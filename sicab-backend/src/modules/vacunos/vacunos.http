# C:\sistemas\sicab\sicab-backend\src\modules\vacunos\vacunos.http
# ----------------------------------------------------------------------
# DEFINICIÓN DE VARIABLES
# ----------------------------------------------------------------------
@baseUrl = http://localhost:3010/api
@baseUrl_vacunos = {{baseUrl}}/vacunos
@baseUrl_constantes = {{baseUrl}}/constantes
@rest-client.previewOption = body

### 1. OBTENER TOKEN DE AUTENTICACIÓN.
# @name login
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "ADMIN",
    "password": "12345678"
}

### 2. GUARDAR TOKEN EN VARIABLE.
@authToken = {{login.response.body.token}}

# ==============================================================================
# AUTENTICACIÓN - USUARIO DE PRUEBA
# ==============================================================================

### 1.b OBTENER TOKEN USUARIO PRUEBA
# @name loginUser3
POST {{baseUrl}}/auth/validar
Content-Type: application/json

{
    "username": "PRUEBA",
    "password": "12345678"
}

### 2.b GUARDAR TOKEN USUARIO PRUEBA
# @authToken = {{loginUser3.response.body.token}}

# ==============================================================================
# ENDPOINT EXTRAS (CONSTANTES)
# ==============================================================================

### OBTENER SEXOS BIOLÓGICOS
GET {{baseUrl_constantes}}?tipo=sexo_biologico_id
Authorization: Bearer {{authToken}}

### OBTENER CONDICIÓN PRODUCTOR DE LECHE
GET {{baseUrl_constantes}}?tipo=condicion_productor_leche_id
Authorization: Bearer {{authToken}}

### OBTENER ESTADOS DE VACUNO
GET {{baseUrl_constantes}}?tipo=estado_vacuno_id
Authorization: Bearer {{authToken}}

# ==============================================================================
# LISTADOS
# ==============================================================================

### LISTAR VACUNOS ACTIVOS
GET {{baseUrl_vacunos}}?estado_id=1000
Authorization: Bearer {{authToken}}

### LISTAR VACUNOS POR ESTADO_VACUNO (6400=ACTIVO)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6400
Authorization: Bearer {{authToken}}

### LISTAR VACUNOS POR SUCURSAL Y ESTADO DE VIDA
GET {{baseUrl_vacunos}}?estado_id=1000&sucursal_id=2&estado_vacuno_id=6400
Authorization: Bearer {{authToken}}

### OBTENER VACUNO POR ID
GET {{baseUrl_vacunos}}/36
Authorization: Bearer {{authToken}}

### VACAS LECHERAS ACTIVAS (Hembras, Productoras, Categoría VACA_LECHERA)
GET {{baseUrl_vacunos}}?estado_id=1000&sexo_biologico_id=6301&es_productor_leche=6351&categoria_vacuno_id=9&estado_vacuno_id=6400
Authorization: Bearer {{authToken}}

### VACAS LECHERAS DE VIACHA (sucursal_id=2)
GET {{baseUrl_vacunos}}?estado_id=1000&sucursal_id=2&sexo_biologico_id=6301&es_productor_leche=6351&categoria_vacuno_id=9&estado_vacuno_id=6400
Authorization: Bearer {{authToken}}

### BUSCAR VACA POR ARETE (Exacto)
GET {{baseUrl_vacunos}}?estado_id=1000&q=000035&exactMatch=1
Authorization: Bearer {{authToken}}

### BUSCAR VACAS CON FILTRO DE TEXTO (Flexible)
GET {{baseUrl_vacunos}}?estado_id=1000&q=LECHERA&exactMatch=0
Authorization: Bearer {{authToken}}

### VACUNOS POR RANGO DE FECHA DE INGRESO
GET {{baseUrl_vacunos}}?estado_id=1000&fecha_ingreso_desde=2024-01-01&fecha_ingreso_hasta=2024-12-31
Authorization: Bearer {{authToken}}

### VACUNOS POR GESTIÓN DE INGRESO (2024)
GET {{baseUrl_vacunos}}?estado_id=1000&gestion_ingreso=2024
Authorization: Bearer {{authToken}}

### VACUNOS POR GESTIÓN DE NACIMIENTO (2023)
GET {{baseUrl_vacunos}}?estado_id=1000&gestion_nacimiento=2023
Authorization: Bearer {{authToken}}

### VACUNOS ORDENADOS POR PESO (Mayor a menor)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6400&sortField=peso_actual&sortOrder=-1&limit=10
Authorization: Bearer {{authToken}}

### VACUNOS POR EMPRESA
GET {{baseUrl_vacunos}}?estado_id=1000&empresa_id=2
Authorization: Bearer {{authToken}}

### VACUNOS HISTÓRICOS (para auditoría)
GET {{baseUrl_vacunos}}?estado_id=1002
Authorization: Bearer {{authToken}}

### VACUNOS VENDIDOS (finales)
GET {{baseUrl_vacunos}}?estado_id=1002&estado_vacuno_id=6404
Authorization: Bearer {{authToken}}

### VACUNOS MUERTOS (finales)
GET {{baseUrl_vacunos}}?estado_id=1002&estado_vacuno_id=6405
Authorization: Bearer {{authToken}}

### VACUNOS FAENADOS (finales)
GET {{baseUrl_vacunos}}?estado_id=1002&estado_vacuno_id=6402
Authorization: Bearer {{authToken}}

### VACUNOS PARA FAENA (vivos, en libros)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6401
Authorization: Bearer {{authToken}}

### VACUNOS PARA VENTA (vivos, en libros)
GET {{baseUrl_vacunos}}?estado_id=1000&estado_vacuno_id=6403
Authorization: Bearer {{authToken}}

### VACUNOS CON PADRE Y MADRE REALES (no comodín)
GET {{baseUrl_vacunos}}?estado_id=1000&padre_id=2&madre_id=6
Authorization: Bearer {{authToken}}

### PAGINACIÓN Y ORDENAMIENTO
GET {{baseUrl_vacunos}}?limit=10&offset=0&sortField=vacuno_id&sortOrder=-1&exactMatch=0&empresa_id=2&sucursal_id=2
Authorization: Bearer {{authToken}}

# ==============================================================================
# GESTIONES DISPONIBLES (Años con datos para filtros)
# ==============================================================================

### OBTENER AÑOS DE INGRESO Y NACIMIENTO
GET {{baseUrl_vacunos}}/gestiones
Authorization: Bearer {{authToken}}

# ==============================================================================
# CRUD VACUNOS
# ==============================================================================

### CREAR VACUNO — Hembra productora de leche
POST {{baseUrl_vacunos}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "sucursal_id": 2,
    "raza_id": 2,
    "tipo_semoviente_id": 2,
    "nombre": "LECHERA 050",
    "fecha_nacimiento": "2023-03-15",
    "fecha_ingreso": "2023-03-15",
    "sexo_biologico_id": 6301,
    "peso_nacimiento": 40.00,
    "peso_actual": 580.00,
    "color": "BLANCO Y NEGRO",
    "padre_id": 2,
    "madre_id": 6,
    "valor_adquisicion": 8000.00,
    "valor_residual": 800.00,
    "es_productor_leche": 6351
}

### ACTUALIZAR VACUNO — Datos generales (Solo campos permitidos)
PATCH {{baseUrl_vacunos}}/36
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "nombre": "BEBE ACTUALIZADO",
    "color": "BLANCO Y NEGRO",
    "peso_actual": 45.00,
    "observaciones": "PESAJE CORREGIDO POR ERROR DE TIPEO"
}

### ACTUALIZAR VACUNO — Fotografía
PATCH {{baseUrl_vacunos}}/36
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="foto"; filename="vaca-001.png"
Content-Type: image/png

< ./fotos/vaca-001.png
--boundary--

### CAMBIAR VACUNO A PARA_FAENA (6401)
PATCH {{baseUrl_vacunos}}/36/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6401
}

### CAMBIAR VACUNO A PARA_VENTA (6403)
PATCH {{baseUrl_vacunos}}/36/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6403
}

### VENDER VACUNO — Solo desde PARA_VENTA (6403)
PATCH {{baseUrl_vacunos}}/36/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6404,
    "fecha_salida": "2026-10-24",
    "motivo_salida": "VENTA POR EXCESO DE PRODUCCION",
    "peso_salida": 580.00,
    "precio_venta": 15000.00
}

### FAENAR VACUNO — Solo desde PARA_FAENA (6401)
PATCH {{baseUrl_vacunos}}/36/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6402,
    "fecha_salida": "2026-10-24",
    "motivo_salida": "FAENA PROGRAMADA",
    "peso_salida": 580.00,
    "precio_venta": 15000.00
}

### REGISTRAR MUERTE DE VACUNO (Estado Final)
PATCH {{baseUrl_vacunos}}/36/estado
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "estado_vacuno_id": 6405,
    "fecha_salida": "2026-10-24",
    "motivo_salida": "MUERTE POR ENFERMEDAD",
    "peso_salida": 580.00,
    "causa_muerte": "NEUMONIA BOVINA"
}

### TRANSFERIR VACUNO A OTRA SUCURSAL
PATCH {{baseUrl_vacunos}}/36/transferir
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "sucursal_destino_id": 3,
    "motivo": "TRASLADO POR ROTACIÓN DE HATO"
}

### ELIMINAR VACUNO (Borrado lógico por error de carga)
DELETE {{baseUrl_vacunos}}/36
Authorization: Bearer {{authToken}}

# ==============================================================================
# GESTIONES DISPONIBLES (Años con datos para filtros)
# ==============================================================================

### OBTENER AÑOS DE INGRESO Y NACIMIENTO
GET {{baseUrl_vacunos}}/gestiones
Authorization: Bearer {{authToken}}

### OBTENER VACUNO POR ID
GET {{baseUrl_vacunos}}/36
Authorization: Bearer {{authToken}}



### OBTENER VACUNO POR ID
GET {{baseUrl_vacunos}}/2
Authorization: Bearer {{authToken}}



### OBTENER VACUNO POR ID
GET {{baseUrl_vacunos}}/64
Authorization: Bearer {{authToken}}


### PAGINACIÓN Y ORDENAMIENTO
GET {{baseUrl_vacunos}}?limit=10&offset=0&sortField=vacuno_id&sortOrder=-1&exactMatch=0&empresa_id=2&sucursal_id=2
Authorization: Bearer {{authToken}}

### BUSCAR VACUNO POR ARETE (Exacto)
GET {{baseUrl_vacunos}}?estado_id=1000&arete=000002
Authorization: Bearer {{authToken}}
